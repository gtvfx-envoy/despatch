/* Global stylesheet for envoy_despatch */

QWidget {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #2d2d2d;
}

QMainWindow {
    background-color: #ffffff;
}

QComboBox {
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 2em;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QLineEdit {
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 8px;
    background: #ffffff;
}

QLineEdit:focus {
    border-color: #0078d4;
}

QPushButton {
    border: 1px solid #cccccc;
    border-radius: 4px;
    padding: 6px 12px;
    background: #f5f5f5;
    min-height: 2em;
}

QPushButton:hover {
    background: #e8e8e8;
    border-color: #0078d4;
}

QPushButton:pressed {
    background: #0078d4;
    color: white;
}

QListWidget {
    border: 1px solid #cccccc;
    border-radius: 4px;
    background: #ffffff;
    padding: 4px;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 2px;
}

QListWidget::item:selected {
    background: #0078d4;
    color: white;
}

QListWidget::item:hover:!selected {
    background: #e8f4ff;
}

QStatusBar {
    border-top: 1px solid #cccccc;
    background: #f5f5f5;
    padding: 4px;
}

QLabel {
    color: #2d2d2d;
}

QPlainTextEdit {
    border: 1px solid #cccccc;
    border-radius: 4px;
    background: #ffffff;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}

/* Scrollbars */
QScrollBar:vertical {
    width: 10px;
    background: #f0f0f0;
}

QScrollBar::handle:vertical {
    background: #cccccc;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #999999;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Progress bar */
QProgressBar {
    border-radius: 3px;
    text-align: center;
    background: #f0f0f0;
}

QProgressBar::chunk {
    background: #4A90D9;
    border-radius: 2px;
}
